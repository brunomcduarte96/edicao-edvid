  "ranges": [
    {
      "source": "intro",
      "start": 0.766667,
      "end": 4.3,
      "quote": "Vou te ensinar a usar IA de verdade enquanto eu como yakisoba aqui.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 17.633333,
      "end": 19.633333,
      "quote": "Primeiro passo, crie sua conta.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 20.0,
      "end": 21.033333,
      "quote": "Crie um projeto.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 46.8,
      "end": 47.733333,
      "quote": "Segundo passo,",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 47.966667,
      "end": 49.3,
      "quote": "conecte o seu e-mail.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 49.5,
      "end": 51.866667,
      "quote": "Usa o MCP, são os plugins.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 66.266667,
      "end": 67.066667,
      "quote": "Terceiro,",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 67.266667,
      "end": 68.633333,
      "quote": "volta no seu projeto",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 69.833333,
      "end": 72.733333,
      "quote": "e pede para ele resumir todos os seus e-mails do dia.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 96.2,
      "end": 97.366667,
      "quote": "Quarto, coloque",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 98.333333,
      "end": 99.4,
      "quote": "em contexto",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 99.933333,
      "end": 102.1,
      "quote": "todos os arquivos relevantes do seu trabalho.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 103.4,
      "end": 104.8,
      "quote": "Cores de",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 105.6,
      "end": 108.8,
      "quote": "design, rotinas, produtos, informações.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 115.6,
      "end": 120.233333,
      "quote": "Assim, o Claude vai ter todo o contexto do seu trabalho para poder te ajudar no dia a dia.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 149.066667,
      "end": 149.833333,
      "quote": "Por último,",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 156.5,
      "end": 158.966667,
      "quote": "agenda uma nova tarefa recorrente.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 217.733333,
      "end": 219.4,
      "quote": "Seleciona onde você quer guardar.",
      "gain_db": 0
    },
    {
      "source": "rosto",
      "start": 213.9,
      "end": 217.533333,
      "quote": "Pronto, você já não vai mais esquecer nenhuma tarefa que você tem que fazer.",
      "gain_db": 0
    },
    {
      "source": "cta",
      "start": 1.6,
      "end": 3.633333,
      "quote": "E já me segue para não perder nenhuma outra dica.",
      "gain_db": 6.5
    },
    {
      "source": "rosto",
      "start": 236.966667,
      "end": 239.333333,
      "quote": "E fala aí, você acha que isso te ajuda no dia a dia?",
      "gain_db": 0
    }
  ],
