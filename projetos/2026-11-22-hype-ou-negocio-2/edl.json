  "grade": "",
  "ranges": [
    {
      "source": "C0001",
      "start": 13.0,
      "end": 17.9,
      "beat": "GANCHO",
      "quote": "Uma startup brasileira com um ano de vida já vale um bilhão de reais.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 20.333333,
      "end": 21.9,
      "beat": "GANCHO",
      "quote": "E ela não faz chatbot.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 27.6,
      "end": 29.133333,
      "beat": "CONTEXTO",
      "quote": "A empresa é a Rivio.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 31.366667,
      "end": 33.333333,
      "beat": "CONTEXTO",
      "quote": "Foi fundada em 2025.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 37.933333,
      "end": 41.633333,
      "beat": "CONTEXTO",
      "quote": "Em dezembro do ano passado, ela valia quinhentos milhões de reais.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 71.166667,
      "end": 73.333333,
      "beat": "CONTEXTO",
      "quote": "finalizaram a rodada série A,",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 73.933333,
      "end": 76.2,
      "beat": "CONTEXTO",
      "quote": "captando cento e oitenta milhões de reais,",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 80.733333,
      "end": 81.8,
      "beat": "CONTEXTO",
      "quote": "a um bilhão",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 82.066667,
      "end": 83.566667,
      "beat": "CONTEXTO",
      "quote": "de reais de valor de mercado.",
      "gain_db": 3
    },
    {
      "source": "C0001",
      "start": 95.5,
      "end": 97.0,
      "beat": "DESENV 1",
      "quote": "A empresa funciona assim.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 102.0,
      "end": 103.433333,
      "beat": "DESENV 1",
      "quote": "O hospital te atende.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 107.866667,
      "end": 110.0,
      "beat": "DESENV 1",
      "quote": "Monta uma conta com tudo que usou,",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 112.733333,
      "end": 114.566667,
      "beat": "DESENV 1",
      "quote": "e manda para o seu plano de saúde.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 119.4,
      "end": 122.433333,
      "beat": "DESENV 1",
      "quote": "O plano confere e recusa o que ele achou errado.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 125.633333,
      "end": 126.566667,
      "beat": "DESENV 1",
      "quote": "Isso tem nome.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 126.933333,
      "end": 127.6,
      "beat": "DESENV 1",
      "quote": "Glosa.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 130.966667,
      "end": 132.6,
      "beat": "DESENV 2",
      "quote": "E a Rivio entra no meio.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 140.9,
      "end": 142.1,
      "beat": "DESENV 2",
      "quote": "Agentes de IA",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 153.366667,
      "end": 155.5,
      "beat": "DESENV 2",
      "quote": "cruzam o prontuário com a conta",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 164.6,
      "end": 166.666667,
      "beat": "DESENV 2",
      "quote": "e com o contrato com o plano",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 168.566667,
      "end": 169.633333,
      "beat": "DESENV 2",
      "quote": "antes de enviar.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 175.233333,
      "end": 176.766667,
      "beat": "DESENV 2",
      "quote": "E se o plano recusa?",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 180.0,
      "end": 181.9,
      "beat": "DESENV 2",
      "quote": "A IA já escreve o recurso.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 186.266667,
      "end": 188.466667,
      "beat": "DESENV 2",
      "quote": "Enfermeiros e auditores revisam.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 193.766667,
      "end": 196.033333,
      "beat": "DESENV 3",
      "quote": "Mas o que me chamou a atenção é como ela cobra.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 201.9,
      "end": 204.466667,
      "beat": "DESENV 3",
      "quote": "Ela ganha pelo resultado que ela gera.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 214.8,
      "end": 216.466667,
      "beat": "DESENV 3",
      "quote": "E, segundo a empresa,",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 217.933333,
      "end": 219.8,
      "beat": "DESENV 3",
      "quote": "se o recurso não passa,",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 223.366667,
      "end": 225.833333,
      "beat": "DESENV 3",
      "quote": "ela cobre a glosa do próprio bolso.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 242.2,
      "end": 244.633333,
      "beat": "PROVOCACAO",
      "quote": "E aqui eu trago uma provocação pra você.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 246.266667,
      "end": 251.433333,
      "beat": "PROVOCACAO",
      "quote": "Qual parte chata do seu trabalho, do seu dia a dia, você acredita que a IA",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 252.4,
      "end": 254.6,
      "beat": "PROVOCACAO",
      "quote": "pode virar uma oportunidade de negócio?",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 262.533333,
      "end": 264.833333,
      "beat": "CTA",
      "quote": "Então me segue aqui se você quiser pensar",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 271.466667,
      "end": 274.5,
      "beat": "CTA",
      "quote": "em como a IA pode te ajudar a abrir o seu primeiro negócio.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 281.266667,
      "end": 281.9,
      "beat": "FECHO",
      "quote": "Falai.",
      "gain_db": 0
    },
    {
      "source": "C0001",
      "start": 284.533333,
      "end": 288.033333,
      "beat": "FECHO",
      "quote": "Você pagaria uma IA se ela só te cobrasse no resultado?",
      "gain_db": 0
    }
  ],
