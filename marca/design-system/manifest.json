      "summary": "Aviso com título curto e uma linha de contexto."
    },
    {
      "name": "Button",
      "group": "Ações",
      "summary": "Botões de ação em quatro níveis: primário (preto), destaque (petróleo), secundário (contorno) e terciário (texto sublinhado)."
    },
    {
      "name": "Card",
      "group": "Conteúdo",
      "summary": "Três tipos de card que separam o conteúdo por papel: preenchido para o principal, contorno para o secundário, inverso para o que mais importa."
    },
    {
      "name": "Field",
      "group": "Formulários",
      "summary": "Campo de texto com rótulo acima e linha de ajuda ou erro abaixo."
    },
    {
      "name": "Progress",
      "group": "Feedback",
      "summary": "Barras de progresso contínuo e de etapas."
    },
    {
      "name": "Tag",
      "group": "Status",
      "summary": "Rótulos retangulares para categorias e status, em eyebrow (12px SemiBold, CAIXA ALTA, +0,08em)."
